# cp .env.example .env  и задать реальный пароль; .env не попадает в git
APP_PORT=8000

# Какой релиз запускать из ghcr.io (используется scripts/deploy.sh и compose.yaml).
# Для локальной сборки оставьте dev.
APP_VERSION=dev

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=guestbook
POSTGRES_USER=guestbook
POSTGRES_PASSWORD=change-me-in-.env
